# SECRETS: server only. Copy to .env.local (git-ignored). Validated at boot (src/config/env.ts): the app refuses to start on a bad value.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Exact browser origins (no paths, no wildcards), comma separated. Required in production.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# Required in production.
FIREBASE_PROJECT_ID=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Used from P1-14 (uploads); not validated yet.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Local development only: point the data layer at the Data Connect emulator (host:port, no scheme). Refused in production.
# Start it with: npx firebase emulators:start --only dataconnect --project demo-oruschools
DATA_CONNECT_EMULATOR_HOST=
# Local development only: Firebase Auth emulator (host:port). REFUSED in production: with it set the Admin SDK does not
# verify token signatures, so a forged token would be accepted.
FIREBASE_AUTH_EMULATOR_HOST=
# Also reject tokens of disabled users / issued before a revocation (one extra Firebase lookup per request). Default true.
AUTH_CHECK_REVOKED=true
