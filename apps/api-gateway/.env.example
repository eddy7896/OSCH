# SECRETS: server only. Copy to .env.local (git-ignored). Validated at boot (src/config/env.ts): the app refuses to start on a bad value.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Exact browser origins (no paths, no wildcards), comma separated. Required in production.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# Required in production.
FIREBASE_PROJECT_ID=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Cloudflare R2 for uploads. ACCOUNT_ID is the 32-character id (or the https://<id>.r2.cloudflarestorage.com address); set all of
# ACCOUNT_ID, ACCESS_KEY, SECRET_KEY, BUCKET_NAME or none (uploads then answer 503). Production refuses a half-set group.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Local development only: point the data layer at the Data Connect emulator (host:port, no scheme). Refused in production.
# Start it with: npx firebase emulators:start --only dataconnect --project demo-oruschools
DATA_CONNECT_EMULATOR_HOST=
# Local development only: Firebase Auth emulator (host:port). REFUSED in production: with it set the Admin SDK does not
# verify token signatures, so a forged token would be accepted.
FIREBASE_AUTH_EMULATOR_HOST=
# Also reject tokens of disabled users / issued before a revocation (one extra Firebase lookup per request). Default true.
AUTH_CHECK_REVOKED=true
# How long an ALLOW decision (active member of an active school) is reused, in ms (0 = off, max 300000). A role change or
# school suspension made elsewhere takes effect within this time; denials are never cached.
TENANT_CACHE_TTL_MS=30000
# Routes marked @Strict() (accepting an invitation): requests per window per signed-in user. Default 10.
THROTTLE_STRICT_LIMIT=10

# Push notifications (FCM) to phones, P4-S2. Off until a Firebase project with messaging is set up. A notice is pushed only if written within PUSH_WINDOW_MINUTES.
PUSH_ENABLED=false
PUSH_WINDOW_MINUTES=10
