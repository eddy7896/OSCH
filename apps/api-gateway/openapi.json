              "hi",
              "ur",
              "ks",
              "sd",
              "ps",
              "fa",
              "ar",
              "bn",
              "as",
              "mr",
              "doi",
              "gu",
              "pa",
              "or",
              "ta",
              "te",
              "kn",
              "ml"
            ],
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "language"
        ],
        "type": "object"
      },
      "UpdateSchoolDto": {
        "properties": {
          "defaultLanguage": {
            "enum": [
              "en",
              "hi",
              "ur",
              "ks",
              "sd",
              "ps",
              "fa",
              "ar",
              "bn",
              "as",
              "mr",
              "doi",
              "gu",
              "pa",
              "or",
