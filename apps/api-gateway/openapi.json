    "securitySchemes": {
      "bearer": {
        "bearerFormat": "Firebase ID token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Multi-tenant school ERP gateway. Every route except the public ones needs a Firebase ID token; school routes also need X-School-Id.",
    "title": "OruSchools API",
    "version": "1"
  },
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "Health_check",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "details": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "responseTime": {
                            "description": "Time the health indicator took to respond, in ms",
                            "type": "number"
                          },
                          "status": {
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "status"
                        ],
                        "type": "object"
                      },
                      "example": {
                        "database": {
                          "responseTime": 12,
                          "status": "up"
                        }
                      },
                      "type": "object"
                    },
                    "error": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "responseTime": {
                            "description": "Time the health indicator took to respond, in ms",
