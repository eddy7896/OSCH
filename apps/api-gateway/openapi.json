{
  "components": {
    "parameters": {
      "SchoolId": {
        "description": "The school the request acts in. Checked against the caller's active membership; never trusted on its own.",
        "in": "header",
        "name": "X-School-Id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      }
    },
    "responses": {
      "Error400": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "description": "The request is not valid (unknown or invalid fields, or a missing or malformed X-School-Id)."
      },
      "Error401": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "description": "No valid sign-in."
      },
      "Error403": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "description": "Not allowed: the caller is not an active member of the school, or lacks the permission, or a record rule refused it. The answer never says which."
      },
      "Error429": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "description": "Too many requests."
      },
      "Error500": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "description": "Something went wrong on the server."
      }
    },
    "schemas": {
      "AccessDto": {
        "properties": {
          "navigation": {
            "items": {
              "$ref": "#/components/schemas/NavSectionDto"
            },
            "type": "array"
          },
          "permissions": {
            "additionalProperties": {
              "additionalProperties": {
                "enum": [
                  "school",
                  "linked",
                  "own"
                ],
                "type": "string"
              },
              "type": "object"
            },
            "type": "object"
          }
        },
        "required": [
          "permissions",
          "navigation"
        ],
        "type": "object"
      },
      "ActiveSchoolDto": {
        "properties": {
          "navigation": {
            "items": {
              "$ref": "#/components/schemas/NavSectionDto"
            },
            "type": "array"
          },
          "permissions": {
            "additionalProperties": {
              "additionalProperties": {
                "enum": [
                  "school",
                  "linked",
                  "own"
                ],
                "type": "string"
              },
              "type": "object"
            },
            "type": "object"
          },
          "role": {
            "type": "string"
          },
          "schoolId": {
            "type": "string"
          }
        },
        "required": [
          "permissions",
          "schoolId",
          "role",
          "navigation"
        ],
        "type": "object"
      },
      "CreateSchoolDto": {
        "properties": {
          "defaultLanguage": {
            "enum": [
              "en",
              "hi",
              "ur",
              "ks",
              "sd",
              "ps",
              "fa",
              "ar",
              "bn",
              "as",
              "mr",
              "doi",
              "gu",
              "pa",
              "or",
              "ta",
              "te",
              "kn",
              "ml"
            ],
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 2,
            "type": "string"
          },
          "subDomain": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "subDomain",
          "defaultLanguage"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "Machine-readable; clients localise the text from it.",
                "enum": [
                  "AUTH_REQUIRED",
                  "FORBIDDEN",
                  "SCHOOL_SUSPENDED",
                  "NOT_FOUND",
                  "INVALID_REQUEST",
                  "CONFLICT",
                  "RATE_LIMITED",
                  "TENANT_REFERENCE_FORBIDDEN",
                  "UPSTREAM_UNAVAILABLE",
                  "INTERNAL"
                ],
                "type": "string"
              },
              "details": {
                "description": "Field and rule names only, never the submitted values.",
                "items": {
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "rule": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "field",
                    "rule"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "message": {
                "description": "English fallback text.",
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "MeLanguageDto": {
        "properties": {
          "chosen": {
            "nullable": true,
            "type": "string"
          },
          "effective": {
            "type": "string"
          }
        },
        "required": [
          "chosen",
          "effective"
        ],
        "type": "object"
      },
      "MeMembershipDto": {
        "properties": {
          "role": {
            "type": "string"
          },
          "school": {
            "$ref": "#/components/schemas/MeSchoolDto"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "school",
          "role",
          "status"
        ],
        "type": "object"
      },
      "MeResponseDto": {
        "properties": {
          "activeSchool": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ActiveSchoolDto"
              }
            ],
            "nullable": true,
            "type": "object"
          },
          "language": {
            "$ref": "#/components/schemas/MeLanguageDto"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/MeMembershipDto"
            },
            "type": "array"
          },
          "platform": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccessDto"
              }
            ],
            "nullable": true,
            "type": "object"
          },
          "user": {
            "$ref": "#/components/schemas/MeUserDto"
          }
        },
        "required": [
          "user",
          "memberships",
          "activeSchool",
          "platform",
          "language"
        ],
        "type": "object"
      },
      "MeSchoolDto": {
        "properties": {
          "defaultLanguage": {
            "type": "string"
          },
