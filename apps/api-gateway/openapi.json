            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "subDomain": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "subDomain",
          "defaultLanguage",
          "status"
        ],
        "type": "object"
      },
      "MeUserDto": {
        "properties": {
          "displayName": {
            "nullable": true,
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "globalRole": {
            "enum": [
              "SUPER_ADMIN",
              "USER"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "globalRole"
        ],
        "type": "object"
      },
      "NavItemDto": {
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "label"
        ],
        "type": "object"
      },
      "NavSectionDto": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/NavItemDto"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "items"
        ],
        "type": "object"
      },
      "SchoolDto": {
        "properties": {
          "createdAt": {
            "type": "string"
          },
          "defaultLanguage": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "subDomain": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "subDomain",
          "status",
          "defaultLanguage",
          "createdAt"
        ],
        "type": "object"
      },
      "SchoolPageDto": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SchoolDto"
            },
            "type": "array"
          },
