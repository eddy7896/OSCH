{
  "components": {
    "parameters": {
      "SchoolId": {
        "description": "The school the request acts in. Checked against the caller's active membership; never trusted on its own.",
        "in": "header",
        "name": "X-School-Id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      }
    },
    "responses": {
      "Error400": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "description": "The request is not valid (unknown or invalid fields, or a missing or malformed X-School-Id)."
      },
      "Error401": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "description": "No valid sign-in."
      },
      "Error403": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "description": "Not allowed: the caller is not an active member of the school, or lacks the permission, or a record rule refused it. The answer never says which."
      },
      "Error429": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "description": "Too many requests."
      },
      "Error500": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "description": "Something went wrong on the server."
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "Machine-readable; clients localise the text from it.",
                "enum": [
                  "AUTH_REQUIRED",
                  "FORBIDDEN",
                  "SCHOOL_SUSPENDED",
                  "NOT_FOUND",
                  "INVALID_REQUEST",
                  "CONFLICT",
                  "RATE_LIMITED",
                  "TENANT_REFERENCE_FORBIDDEN",
                  "UPSTREAM_UNAVAILABLE",
                  "INTERNAL"
                ],
                "type": "string"
              },
              "details": {
                "description": "Field and rule names only, never the submitted values.",
                "items": {
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "rule": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "field",
                    "rule"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "message": {
                "description": "English fallback text.",
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "Firebase ID token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Multi-tenant school ERP gateway. Every route except the public ones needs a Firebase ID token; school routes also need X-School-Id.",
    "title": "OruSchools API",
    "version": "1"
  },
  "openapi": "3.0.0",
