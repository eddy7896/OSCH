# Master reference for every environment variable in the monorepo. Copy the relevant lines to the file named in
# each section. NEVER commit real values (.env* is git-ignored except .env.example files). See documentation/environment.md.

# ONE master file: copy this to <repo root>/.env.local. The gateway, the three Next apps and tools/ all read it.
# ── gateway and tools (SECRETS: server only) ─────────────────────────────────────────────────────────
PORT=3000
FIREBASE_PROJECT_ID=
# Absolute path to the service-account JSON, kept OUTSIDE the repo (Firebase console > Project settings > Service accounts).
GOOGLE_APPLICATION_CREDENTIALS=
# Cloudflare R2 (S3-compatible). Server-side only: the gateway issues pre-signed upload URLs; clients never see these.
# R2_ACCOUNT_ID is the 32-character account id (the https://<id>.r2.cloudflarestorage.com address is accepted too). All four of
# ACCOUNT_ID, ACCESS_KEY, SECRET_KEY and BUCKET_NAME, or none (then uploads answer 503). R2_PUBLIC_URL is the bucket's public address.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# The PRIVATE bucket (student photos and documents). No public access, no r2.dev. The same API token must cover both buckets.
R2_PRIVATE_BUCKET_NAME=
# Browser origins allowed to call the gateway. Empty means NO browser can (the web apps then show "We could not reach the server"). Development value shown; in production list the real app addresses. `https://*.domain` allows every school's own address, one label deep.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://*.localhost:3002

# ── web apps (PUBLIC: anything NEXT_PUBLIC_* is shipped to the browser) ──
# The Firebase web API key identifies the project and is public by design; it is NOT a secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_API_URL=http://localhost:3000
# The domain schools live under (greenfield.oruschools.com has base domain oruschools.com). In development: localhost, and open http://<school>.localhost:3002
NEXT_PUBLIC_BASE_DOMAIN=localhost

# ── Flutter apps: no .env file. Public config is passed at build time with --dart-define (see documentation/environment.md).
