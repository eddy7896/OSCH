{
  "name": "oruschools-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check:drift": "node tools/checks/drift-check.mjs",
    "eval": "node tools/checks/drift-check.mjs && node --test evals/*.test.mjs",
    "eval:agent": "node evals/grade-answers.mjs",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:build": "npm run build --workspace @oruschools/shared-design-tokens",
    "tokens:check": "npm run check --workspace @oruschools/shared-design-tokens --silent",
    "test:dataconnect": "bash tools/tests/dataconnect-tenancy.sh",
    "i18n:build": "npm run generate --workspace @oruschools/i18n",
    "i18n:check": "npm run check --workspace @oruschools/i18n --silent",
    "test:database": "bash tools/tests/database-admin.sh",
    "test:gateway": "bash tools/tests/gateway-integration.sh"
  },
  "devDependencies": {
    "firebase-tools": "^15.34.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "sharp": "^0.35.5",
    "turbo": "^2.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "yaml": "^2.8.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.3"
  }
}
