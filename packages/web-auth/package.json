  },
  "devDependencies": {
    "@oruschools/i18n": "*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "next-intl": "^4.14.9",
    "oxlint": "^1.58.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
