{
  "name": "@oruschools/database",
  "version": "0.0.0",
  "private": true,
  "description": "Data Connect Admin SDK wrapper used by the API gateway (tenant-scoped data access).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.config.integration.ts"
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.3",
    "oxlint": "^1.58.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@oruschools/erp-admin-sdk": "file:generated/erp-admin-sdk",
    "firebase-admin": "^14.5.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
