{
  "name": "@oruschools/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the API gateway, generated from its OpenAPI spec.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test",
    "test": "vitest run --passWithNoTests && npm run check",
    "generate": "node scripts/generate.mjs",
    "generate:dart": "node scripts/generate-dart.mjs",
    "check": "node scripts/generate.mjs --check && node scripts/generate-dart.mjs --check"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
