{
  "name": "@oruschools/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Languages (English primary; Hindi, Urdu and other RTL and regional languages): registry, message catalogs, fonts, direction. Generates web, Flutter and CSS artefacts (ADR-0006).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./i18n.css": "./generated/i18n.css"
  },
  "files": [
    "dist",
    "generated"
  ],
  "scripts": {
    "generate": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "prebuild": "node scripts/build.mjs --check --quiet",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src scripts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
